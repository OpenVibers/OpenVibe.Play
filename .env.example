# OpenVibe.Play — environment (production: /etc/openvibe/play.env). Names only; never commit values.

NODE_ENV=production
PORT=5040
HOST=127.0.0.1
BASE_URL=https://play.openvibe.network
TRUST_PROXY=2
# PostgreSQL (ADR-035), written by OpenVibe.Host roles/data/add-service.sh play: the runtime role through PgBouncer,
# the owner on a direct connection (migrations), and Valkey (shared limit counters).
# Without DATABASE_URL, development uses an embedded PGlite database in data/pglite.
DATABASE_URL=
DATABASE_DIRECT_URL=
VALKEY_URL=
VALKEY_PREFIX=ov:play:
# Per-caller limits (server/http/caller-limits.js): requests one caller may make to the API per minute and per hour.
#PLAY_LIMITS_MINUTE=120
#PLAY_LIMITS_HOUR=3000

# OpenVibe.Network: SSO (OAuth client `play`, PKCE S256) and its JWKS; app tokens for audience openvibe.play (Network's rule: openvibe.<service>).
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
OV_OAUTH_CLIENT_ID=play
OV_OAUTH_CLIENT_SECRET=
# OV_OAUTH_REDIRECT_URI=https://play.openvibe.network/auth/callback
# PLAY_AUDIENCE=openvibe.play

# optional: defaults to true in production
# COOKIE_SECURE=true

# OpenVibe.Events: PLAY_EVENTS_SECRET signs the deliveries to POST /internal/events (account export and deletion;
# comma-separated for rotation, 32+ characters each). Unset: the route answers 503 and no subscription is created.
#EVENTS_URL=http://127.0.0.1:4300
#PLAY_EVENTS_SECRET=
